# Variáveis públicas podem ser usadas no navegador; nunca coloque a service_role aqui.
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_CHAVE_ANON

# Chave exclusiva do servidor para rotas administrativas (não enviar ao Git).
SUPABASE_SERVICE_ROLE_KEY=SUA_CHAVE_PRIVADA

# Única conta Google autorizada a acessar o painel administrativo.
ADMIN_EMAIL=seu-email@gmail.com

# Endereço final usado para criar links absolutos de compartilhamento.
NEXT_PUBLIC_SITE_URL=https://seu-site.example.com
